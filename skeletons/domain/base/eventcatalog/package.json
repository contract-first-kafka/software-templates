{
  "name": "domain-eventcatalog",
  "private": true,
  "type": "module",
  "scripts": {
    "discover": "node scripts/discover.mjs",
    "generate": "node scripts/generate.mjs",
    "build": "EVENTCATALOG_DISABLE_CHANNEL_MIGRATION=true eventcatalog build && node scripts/package-runtime.mjs",
    "start": "EVENTCATALOG_DISABLE_CHANNEL_MIGRATION=true eventcatalog start"
  },
  "dependencies": {
    "@eventcatalog/core": "5.4.1"
  },
  "devDependencies": {
    "yaml": "2.8.3",
    "@asyncapi/parser": "3.6.0",
    "@asyncapi/avro-schema-parser": "3.0.24",
    "@eventcatalog/sdk": "2.31.2"
  }
}
